# --- LiveKit (transport, room, worker auth) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Rime (primary spoken output — never expose this key client-side) ---
RIME_API_KEY=your_rime_api_key
RIME_MODEL=coda
RIME_SPEAKER=astra
# Rime accepts both the 3-letter code ("eng") and its ISO 639-1 equivalent
# ("en") for Coda. This value is passed as `lang=` to the Rime plugin.
RIME_LANGUAGE=en
# Leave unset to use Rime's default public WebSocket endpoint
# (wss://users-ws.rime.ai). Set only for a VPC/on-prem deployment.
RIME_ENDPOINT=

# --- Dev / demo controls ---
# Overridden live by the frontend's "Tool delay" selector; this is only the
# default used when the agent starts or when running evaluation/stress_test.py
# directly without the UI.
FLOWVOICE_TOOL_DELAY_MS=0
